# =============================================================================
# AMSC_STFT — everything that is produced, never authored.
#
# The rule of thumb: if a command creates it, it belongs here. Build trees,
# benchmark output, parsed CSVs, figures and generated audio are all
# reproducible from the sources, and keeping them out of the repository is what
# makes a fresh clone small enough to read.
# =============================================================================

# ── Build trees ──────────────────────────────────────────────────────────────
build/
bin/
lib/
out/
.cmake/
CMakeCache.txt
CMakeFiles/
compile_commands.json

# ── Object files, libraries, executables ─────────────────────────────────────
*.d
*.slo
*.lo
*.o
*.obj
*.su
*.exe
*.dll
*.so
*.dylib
*.a
*.lib

# ── Everything a run produces ────────────────────────────────────────────────
# One tree, so one rule covers it. Each subdirectory is named after what
# writes to it:
#     results/results_benchmark/  run_suite.sh: benchmark CSVs, environment log
#     results/results_test/       run_suite.sh: ctest log and working copy
#     results/results_analysis/   parse_results.py + plot_results.py output
#     results/results_examples/   the spectrograms the two examples write
results/
tmp/

# Older layouts and stray overrides, kept so a run that predates the tree above
# — or one pointed elsewhere with -o / --out — cannot be committed by accident.
results-*/
benchmark-results*/
csv/
plots/
raw/
analysis/csv/
analysis/figures/
ctest-run/

# SLURM / PBS job logs
*.out
*.err
amsc_stft_job.*

# ── Generated media ──────────────────────────────────────────────────────────
# Spectrograms and the audio the examples and tests synthesise.
*.ppm
*.png
*.mp3
*.wav
# ...except the two audio files under core/examples/data/. They are inputs, not
# output: the examples analyse them, and test_WavReader reads test_audio.wav —
# without it that test does not fail, it silently skips, which is worse.
!core/examples/data/test_audio.wav
!core/examples/data/scale.wav

# ── Containers ───────────────────────────────────────────────────────────────
*.sif

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── Editors and local tooling ────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.kdev4
.DS_Store
.claude/settings.local.json
