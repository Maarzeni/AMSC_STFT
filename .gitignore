# =============================================================================
# AMSC_STFT — everything that is produced, never authored.
#
# The rule of thumb: if a command creates it, it belongs here. Build trees,
# benchmark output, parsed CSVs, figures and generated audio are all
# reproducible from the sources, and keeping them out of the repository is what
# makes a fresh clone small enough to read.
# =============================================================================

# ── Build trees ──────────────────────────────────────────────────────────────
build/
bin/
lib/
out/
.cmake/
CMakeCache.txt
CMakeFiles/
compile_commands.json

# ── Object files, libraries, executables ─────────────────────────────────────
*.d
*.slo
*.lo
*.o
*.obj
*.su
*.exe
*.dll
*.so
*.dylib
*.a
*.lib

# ── Everything a run produces ────────────────────────────────────────────────
# One tree, so one rule covers it:
#     results/raw/      the text tables from run_suite.sh and the CI artifacts
#     results/csv/      parse_results.py output
#     results/figures/  plot_results.py output
results/
ctest-run/
tmp/

# Older layouts and stray overrides, kept so a run that predates the tree above
# — or one pointed elsewhere with -o / --out — cannot be committed by accident.
results-*/
benchmark-results*/
csv/
plots/

# SLURM / PBS job logs
*.out
*.err
amsc_stft_job.*

# ── Generated media ──────────────────────────────────────────────────────────
# Spectrograms and the audio the examples and tests synthesise.
*.ppm
*.png
*.mp3
*.wav
# ...except the one fixture test_WavReader needs: without it the test does not
# fail, it silently skips, which is worse. 88 KB is a fair price for that.
!core/tests/data/test_audio.wav

# ── Containers ───────────────────────────────────────────────────────────────
*.sif

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── Editors and local tooling ────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.kdev4
.DS_Store
.claude/settings.local.json
