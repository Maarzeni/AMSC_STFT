#!/bin/bash
# =============================================================================
# AMSC_STFT — full benchmark suite on the MOX students cluster (OpenPBS).
#
# Submit from the login node:
#     cd /work/$USER/AMSC_STFT
#     qsub scripts/job_mox.pbs
#
# Watch it:  qstat -u $(whoami)          Cancel it:  qdel <JOBID>
# Output:    amsc_stft.o<JOBID>          (stderr is merged into it by -j oe)
#
# The cluster guide forbids computing on login01 — anything above 20% of one
# logical core there is killed automatically — so every measurement has to come
# through PBS. This script is the only supported way to run the suite on MOX.
# =============================================================================

#PBS -N amsc_stft
#PBS -q cpu
#PBS -l select=1:ncpus=32:mpiprocs=32
#PBS -l walltime=02:00:00
#PBS -j oe

## Resources: one node, 32 hardware threads, all usable as MPI slots. The CPU
## nodes carry 112 threads each, so raising ncpus is possible — check the queue
## limits first with `qstat -Qf cpu`, and keep ncpus == mpiprocs so the rank
## sweep can reach the full allocation. Walltime is generous on purpose: the
## whole suite takes ~15 minutes, and a job killed at the limit loses everything.

set -uo pipefail

PROJECT="/work/${USER}/AMSC_STFT"

# Build and run on node-local scratch. It is the fast filesystem (the shared
# ones are NFS over 1 Gbps), which the cluster guide asks us to use for the
# actual work — and it keeps compile I/O off /work entirely.
WORKDIR="/scratch_local/${USER}/amsc_stft.${PBS_JOBID}"

echo "job      : ${PBS_JOBID}"
echo "node     : $(hostname)"
echo "queue    : ${PBS_QUEUE:-?}"
echo "slots    : ${NCPUS:-?} ncpus, $(wc -l < "${PBS_NODEFILE}") MPI slots"
echo "project  : ${PROJECT}"
echo "workdir  : ${WORKDIR}"

# ── Toolchain ────────────────────────────────────────────────────────────────
# Spack is the documented way to get a compiler and an MPI on the compute nodes.
# The binaries are rebuilt here rather than reused from the login node, so they
# are guaranteed to match the toolchain and the CPU the job actually runs on.
if [ -f /software/spack/share/spack/setup-env.sh ]; then
    source /software/spack/share/spack/setup-env.sh
    spack load gcc@15.2.0        || echo "WARNING: spack gcc not loaded, using system gcc"
    spack load openmpi@5.0.8     || echo "WARNING: spack openmpi not loaded, using system MPI"
else
    echo "WARNING: spack not found, falling back to whatever is in PATH"
fi
echo "compiler : $(command -v g++)  $(g++ --dumpversion 2>/dev/null)"
echo "mpi      : $(command -v mpirun)"

# ── Build ────────────────────────────────────────────────────────────────────
mkdir -p "${WORKDIR}"
cd "${WORKDIR}" || exit 1

cmake -S "${PROJECT}/ft_project" -B "${WORKDIR}/build" -DCMAKE_BUILD_TYPE=Release
cmake --build "${WORKDIR}/build" -j "${NCPUS:-8}"
if [ ! -x "${WORKDIR}/build/benchmarks/benchmark_Main" ]; then
    echo "ERROR: build failed, nothing to measure" >&2
    exit 1
fi

# ── Run ──────────────────────────────────────────────────────────────────────
# run_suite.sh reads PBS_NODEFILE/NCPUS to size its sweeps to the allocation,
# and sets OMP_NUM_THREADS explicitly for every single measurement. That second
# part matters here: the cluster guide warns that asking PBS for N threads does
# not by itself stop a program from using more, so for a scaling study the limit
# has to be enforced by the code — which is what the suite does.
#
# 15 repetitions and up to 60 s of audio instead of the 7/30 defaults: a compute node
# is quiet enough to deserve the extra statistics, and longer runs make a stray
# interruption a smaller fraction of each measurement.
# "mox-cpu" (the queue name), not plain "mox": the earlier login-node runs are
# already labelled mox_*, and a compute-node measurement must never be averaged
# together with one taken on a shared login node.
export PREFIX=mox-cpu
export BUILD_DIR="${WORKDIR}/build"
export RESULTS_DIR="${WORKDIR}/results"
export BENCH_ARGS="15 3 1024 512"
# Three workloads, one curve each in the scaling figures: whether the parallel
# gain grows with the problem is the question those plots exist to answer, and a
# single duration draws a single line that cannot answer it.
export SCALING_DURATIONS="5 15 60"
export MEM_DURATION=60

bash "${PROJECT}/scripts/run_suite.sh"
SUITE_STATUS=$?

# ── Save the results ─────────────────────────────────────────────────────────
# /scratch_local is node-local and swept after 30 days, so anything worth having
# must be copied back before the job ends. The job id keeps runs from
# overwriting each other.
DEST="${PROJECT}/results-mox-${PBS_JOBID%%.*}"
mkdir -p "${DEST}"
cp -r "${RESULTS_DIR}/." "${DEST}/" && echo "results copied to ${DEST}"
ls -1 "${DEST}" | sed 's/^/  /'

# Node-local scratch is not shared, so tidy up after ourselves.
rm -rf "${WORKDIR}"

exit "${SUITE_STATUS}"
